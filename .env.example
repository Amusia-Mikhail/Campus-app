# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# ADMIN_PASSWORD: Gated password for the hidden admin key management panel.
ADMIN_PASSWORD="change-me"

# Supabase Credentials (server-side, used by server.ts)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Credentials (client-side, exposed to the browser via Vite)
# These MUST be prefixed with VITE_ to be available in the frontend bundle.
# Use the same values as SUPABASE_URL / SUPABASE_ANON_KEY above.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
